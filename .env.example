# KnowledgeSmith AI Configuration
# Copy this file to .env and fill in your values.

# Root directory for source ingestion (absolute or relative path)
KNOWLEDGESMITH_INGESTION_ROOT=.

# Output directory for generated knowledge artifacts
KNOWLEDGESMITH_OUTPUT_DIR=./output

# Maximum file size in bytes for ingestion (default: 1 MB)
KNOWLEDGESMITH_MAX_FILE_SIZE=1048576

# Google Gemini API key (required for LLM extraction)
GOOGLE_API_KEY=

# Model name for LLM extraction
KNOWLEDGESMITH_MODEL=gemini-2.5-flash

# Enable LLM-based extraction (true/false)
KNOWLEDGESMITH_USE_LLM=false

# Allowed file extensions for ingestion (comma-separated)
KNOWLEDGESMITH_ALLOWED_EXTENSIONS=.md,.txt,.py,.json,.yaml,.yml

# Log level
KNOWLEDGESMITH_LOG_LEVEL=INFO
